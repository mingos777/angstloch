{
  "name": "angstloch",
  "version": "1.0.0",
  "description": "A suite of map generators for roguelike games.",
  "license": "BSD-3-Clause",
  "author": "Dominik Marczuk",
  "homepage": "https://github.com/mingos777/angstloch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingos777/angstloch.git"
  },
  "bugs": {
    "url": "https://github.com/mingos777/angstloch/issues"
  },
  "keywords": [
    "roguelike",
    "procedural-generation",
    "procgen",
    "map-generator",
    "dungeon-generator",
    "maze",
    "dungeon",
    "cave",
    "cellular-automata",
    "gamedev",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/angstloch.js",
  "module": "./dist/angstloch.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/angstloch.js"
    }
  },
  "scripts": {
    "dev": "vite demo --port 5180 --strictPort",
    "build": "vite build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:version && npm run check:docs && npm run docs:maps -- --check && npm run check:package",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:forest": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/check-forest.ts'))\" --",
    "check:version": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/check-version.ts'))\" --",
    "check:package": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/check-package.ts'))\" --",
    "check:docs": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/check-docs.ts'))\" --",
    "docs:maps": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/docs-maps.ts'))\" --",
    "check:dungeon": "node -e \"import('vite').then(({ runnerImport }) => runnerImport('./scripts/check-dungeon.ts'))\" --"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.60.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
